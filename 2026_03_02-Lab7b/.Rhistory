library(dplyr)
library(ggplot2)
library(janitor)
# Load Titanic CSV
titanic <- read.csv("E:/Coding/DS_TEB20243/2026_03_09-Lab8b/titanic.csv", stringsAsFactors = FALSE)
# Clean column names to remove spaces/special characters
titanic <- titanic %>% clean_names()   # this converts age -> age, fare -> fare etc.
# Verify column names
colnames(titanic)
